{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    ".turbo/**",
    "dist/**",
    "coverage/**",
    "vendor/**",
    ".changeset/pre.json"
  ]
}
