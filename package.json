{
  "name": "harbr",
  "version": "0.0.0-private",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "3.21.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:tui": "bun run --cwd apps/tui build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "package:release": "bun scripts/package-release.ts",
    "check:migrations": "bun run --cwd packages/db db:migration:check",
    "check:schema": "bun run --cwd packages/config schema:check",
    "lint": "oxlint --deny-warnings . && bun scripts/check-package-boundaries.ts",
    "lint:fix": "oxlint --fix --deny-warnings . && bun scripts/check-package-boundaries.ts",
    "test": "vitest run",
    "test:herdr-plugin": "sh herdr-plugin/scripts/open.test.sh",
    "test:installer": "sh scripts/install.test.sh",
    "test:e2e:tui-themes": "bun run --cwd apps/tui test:e2e:tui-themes",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run test && bun run test:installer && bun run test:herdr-plugin && bun run typecheck && bun run check:migrations && bun run check:schema && bun run format:check",
    "sync": "bun run --cwd apps/tui sync",
    "sync:json": "bun run --cwd apps/tui sync:json",
    "sync:compiled": "bun run build:tui && bun run --cwd apps/tui sync:compiled",
    "sync:compiled:json": "bun run build:tui && bun run --cwd apps/tui sync:compiled:json",
    "profile:up": "bun run --cwd apps/tui profile:up",
    "profile:down": "bun run --cwd apps/tui profile:down",
    "profile:status": "bun run --cwd apps/tui profile:status"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.2",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.87.0"
  }
}
