{
  "name": "@harbr/tui",
  "version": "0.1.0-beta.7",
  "private": true,
  "type": "module",
  "dependencies": {
    "@effect/opentelemetry": "0.63.0",
    "@effect/platform": "0.96.1",
    "@harbr/config": "workspace:*",
    "@harbr/db": "workspace:*",
    "@harbr/domain": "workspace:*",
    "@harbr/git": "workspace:*",
    "@harbr/reconciler": "workspace:*",
    "@harbr/runtime": "workspace:*",
    "@harbr/runtime-herdr": "workspace:*",
    "@harbr/runtime-tmux": "workspace:*",
    "@opentui/core": "^0.2.16",
    "@opentui/keymap": "^0.2.16",
    "@opentui/react": "^0.2.16",
    "effect": "catalog:",
    "react": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync": "bun src/index.tsx sync",
    "sync:json": "bun src/index.tsx sync --json",
    "sync:compiled": "./dist/harbr sync",
    "sync:compiled:json": "./dist/harbr sync --json",
    "test:e2e:tui-themes": "bun scripts/e2e-themes.ts",
    "test:e2e:terminal-control": "bun run build && bun scripts/e2e-terminal-control.ts",
    "record:walkthrough": "bun scripts/record-walkthrough.ts",
    "render:walkthrough": "bun scripts/render-walkthrough.ts",
    "test:e2e:startup-layout": "bun scripts/e2e-startup-layout.tsx",
    "profile:up": "bun src/index.tsx profile up",
    "profile:down": "bun src/index.tsx profile down",
    "profile:status": "bun src/index.tsx profile status"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@harbr/test-utils": "workspace:*",
    "@kitlangton/terminal-control": "1.2.1",
    "@remotion/cli": "^4.0.534",
    "@types/react": "^19.2.17",
    "react-dom": "19.2.7",
    "remotion": "^4.0.534"
  }
}
